rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /reports/{staffUid}/{reportId}/{filename} {
      // Staff can read their own media; managers and admins can read authorized reports
      allow read: if isAuthenticated();

      // Staff can upload photos and videos to their own folder path
      allow write: if isAuthenticated() && (
        request.auth.uid == staffUid ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin'
      ) && request.resource.size < 100 * 1024 * 1024; // 100MB max limit
    }
  }
}
