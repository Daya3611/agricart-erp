rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/erp_emp/$(request.auth.uid))
        ? get(/databases/$(database)/documents/erp_emp/$(request.auth.uid)).data
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            : {});
    }

    function isSuperAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'super_admin' || getUserData().role == 'super_admin');
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || getUserData().role == 'admin' || isSuperAdmin());
    }

    function isManager() {
      return isAuthenticated() && (request.auth.token.role == 'manager' || getUserData().role == 'manager' || isAdmin());
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ==========================================
    // ERP Employee Collection: erp_emp
    // ==========================================
    match /erp_emp/{userId} {
      allow read: if isOwner(userId) || isManager() || isAdmin();
      // Only admins/super_admins can create employee profiles
      allow create: if isAdmin();
      // Updates: Super Admin can update anything. Admins cannot modify Super Admin.
      // Staff/Owners can only update personal contact fields, NOT roles, employeeId, department, etc.
      allow update: if (isSuperAdmin()) || 
        (isAdmin() && resource.data.role != 'super_admin') || 
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'accountStatus', 'employeeId', 'departmentId', 'assignedCenterIds', 
            'reportingManagerUid', 'workScheduleId', 'createdByUid'
          ])
        );
      allow delete: if isSuperAdmin();
    }

    // Legacy Users Collection (preserved for compatibility)
    match /users/{userId} {
      allow read: if isOwner(userId) || isManager() || isAdmin();
      allow create: if isAdmin();
      allow update: if (isSuperAdmin()) || (isAdmin() && resource.data.role != 'super_admin') || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus', 'employeeId', 'departmentId', 'assignedCenterIds', 'reportingManagerUid'])
      );
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // Departments & Centers
    // ==========================================
    match /erp_departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /erp_centers/{centerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /centers/{centerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // Daily Reports: erp_daily_reports
    // ==========================================
    match /erp_daily_reports/{reportId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.staffUid) ||
        (isManager() && (getUserData().departmentId == resource.data.departmentId || resource.data.centerId in getUserData().assignedCenterIds)) ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.staffUid == request.auth.uid || isAdmin()
      );

      allow update: if isAuthenticated() && (
        (isOwner(resource.data.staffUid) && resource.data.status != 'approved') ||
        (isManager() && (getUserData().departmentId == resource.data.departmentId || resource.data.centerId in getUserData().assignedCenterIds)) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    match /dailyReports/{reportId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.staffUid) ||
        (isManager() && (getUserData().departmentId == resource.data.departmentId || resource.data.centerId in getUserData().assignedCenterIds)) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.staffUid == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.staffUid) && resource.data.status != 'approved') ||
        (isManager() && (getUserData().departmentId == resource.data.departmentId || resource.data.centerId in getUserData().assignedCenterIds)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Attendance Sessions: erp_attendance_sessions
    // ==========================================
    match /erp_attendance_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.employeeUid) || isManager() || isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.employeeUid == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        isOwner(resource.data.employeeUid) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Field Activity Reports & Activities
    // ==========================================
    match /erp_field_reports/{reportId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.staffUid) ||
        (isManager() && (getUserData().departmentId == resource.data.departmentId || resource.data.centerId in getUserData().assignedCenterIds)) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.staffUid == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.staffUid) && resource.data.status != 'approved') ||
        (isManager() && (getUserData().departmentId == resource.data.departmentId || resource.data.centerId in getUserData().assignedCenterIds)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /erp_field_activities/{activityId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.staffUid) || isManager() || isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.staffUid == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /erp_field_report_attachments/{attId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /erp_field_report_revisions/{revId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /erp_field_report_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isManager() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /erp_field_report_sync_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // Attachments, Comments & Revisions
    // ==========================================
    match /erp_report_attachments/{attId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /reportAttachments/{attId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /erp_report_comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isManager();
      allow update, delete: if isAdmin();
    }

    match /reportComments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isManager();
      allow update, delete: if isAdmin();
    }

    match /erp_report_revisions/{revId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Revisions are immutable audit snapshots
    }

    match /reportRevisions/{revId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // ==========================================
    // Work Schedules & Holidays & Leaves
    // ==========================================
    match /erp_work_schedules/{schedId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /erp_holidays/{holId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /erp_leave_records/{leaveId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.staffUid) || isManager() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.staffUid == request.auth.uid;
      allow update: if isManager() || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // System Settings, Reminder Logs & Audit Logs
    // ==========================================
    match /erp_reminder_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server Admin SDK only
    }

    match /reminderLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /erp_email_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server Admin SDK only
    }

    match /emailLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /erp_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Immutable audit log written only via Admin SDK
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /erp_system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
